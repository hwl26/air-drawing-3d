# Local Node service. Keep real keys in .env; never share or commit that file.
PORT=8000

# Fill in your Hyper3D Rodin image/text to 3D API key after the equals sign.
RODIN_API_KEY=

# Volcengine Ark Seedream image editing.
# Use a model ID or endpoint ID enabled for image editing in your Ark account.
# Fill in your Ark API key and enabled model/endpoint ID after the equals signs.
SEEDREAM_API_KEY=
SEEDREAM_MODEL=

# Optional: an enabled Ark vision model for image-aware prompt drafting.
# Copy the model field from the API example for an available vision model in Ark.
# Use its full model ID or ep-* endpoint ID; do not reuse the Seedream model.
# IDs and access vary by account and can expire; do not copy a stale example ID.
# Leave empty to use the local text template instead.
IMAGE_PROMPT_MODEL=
